<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutArLensModeDockRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pro_drawer"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp"
    android:elevation="24dp"
    android:visibility="gone">

    <!-- AR Lens Mode Dock Sub-Tab Bar + Calibrate & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tabs_bar"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/tabArDockLenses"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:paddingHorizontal="8dp"
                    android:gravity="center"
                    android:text="FACE"
                    android:textColor="#0F172A"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_active" />

                <TextView
                    android:id="@+id/tabArDockHand"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:paddingHorizontal="8dp"
                    android:gravity="center"
                    android:text="HAND"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/tabArDockBody"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:paddingHorizontal="8dp"
                    android:gravity="center"
                    android:text="BODY"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/tabArDockWorld"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:paddingHorizontal="8dp"
                    android:gravity="center"
                    android:text="WORLD"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/tabArDockMix"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:paddingHorizontal="8dp"
                    android:gravity="center"
                    android:text="MIX"
                    android:textColor="#F472B6"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/tabArDockComicText"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:paddingHorizontal="8dp"
                    android:gravity="center"
                    android:text="TEXT"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnArSurprise"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="7dp"
            android:gravity="center"
            android:text="ROLL"
            android:textColor="#0F172A"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/bg_cinema_button_active" />

        <TextView
            android:id="@+id/btnArCalibrate"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="7dp"
            android:gravity="center"
            android:text="STUDIO"
            android:textColor="#38BDF8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/bg_cinema_button_inactive" />

        <TextView
            android:id="@+id/btnArDockToggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="v"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/bg_cinema_button_inactive" />
    </LinearLayout>

    <!-- Active Lens Readout + Shutter Hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvArDockStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AR LENS: CYBERPUNK VISOR"
            android:textColor="#E879F9"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvArShutterHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="2-FINGER: PLACE · SIZE · TILT"
            android:textColor="#94A3B8"
            android:textSize="8sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btnArGestureReset"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="7dp"
            android:gravity="center"
            android:text="RESET"
            android:textColor="#FDA4AF"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:background="@drawable/bg_cinema_button_inactive" />
    </LinearLayout>

    <!-- Collapsible Content Body -->
    <FrameLayout
        android:id="@+id/layoutArDockBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Panel 1: AR Lenses Horizontal Scroll Strip -->
        <HorizontalScrollView
            android:id="@+id/scrollArModeLensesStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/layoutArModeLensesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnArNone"
                    android:layout_width="wrap_content"
                    android:minWidth="64dp"
                    android:layout_height="36dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="OFF"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/btnArMesh"
                    android:layout_width="wrap_content"
                    android:minWidth="76dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="3D MESH"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/btnArVisor"
                    android:layout_width="wrap_content"
                    android:minWidth="88dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="CYBER VISOR"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_active" />

                <TextView
                    android:id="@+id/btnArCrown"
                    android:layout_width="wrap_content"
                    android:minWidth="96dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="GOLDEN CROWN"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/btnArHud"
                    android:layout_width="wrap_content"
                    android:minWidth="84dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="SCI-FI HUD"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/btnArComicFrame"
                    android:layout_width="wrap_content"
                    android:minWidth="92dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="COMIC FRAME"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/btnArImportGlb"
                    android:layout_width="wrap_content"
                    android:minWidth="84dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="+ .GLB"
                    android:textColor="#34D399"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/btnArBatch"
                    android:layout_width="wrap_content"
                    android:minWidth="88dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="BATCH: OFF"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Panel 2A: Dedicated HAND AR Quick Strip -->
        <HorizontalScrollView
            android:id="@+id/scrollArModeHandStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:id="@+id/btnDockHandOff" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="OFF" android:textColor="#94A3B8" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockHandCyber" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="CYBER GAUNTLET" android:textColor="#34D399" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockHandGold" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="ROYAL JEWELRY" android:textColor="#FACC15" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockHandOrb" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="ARCANE ORB" android:textColor="#22D3EE" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockHandFlame" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="PYRO WAND" android:textColor="#FB923C" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockHandSkel" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="21-PT SKEL" android:textColor="#CBD5E1" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Panel 2B: Dedicated BODY AR Quick Strip -->
        <HorizontalScrollView
            android:id="@+id/scrollArModeBodyStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:id="@+id/btnDockBodyOff" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="OFF" android:textColor="#94A3B8" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockBodySnapDust" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="SNAP DUST" android:textColor="#FBBF24" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockBodyLockBg" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="LOCK BG" android:textColor="#34D399" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" android:visibility="gone" />
                <TextView android:id="@+id/btnDockBodySnapNow" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="SNAP!" android:textColor="#0F172A" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_active" android:visibility="gone" />
                <TextView android:id="@+id/btnDockBodyGauntlet" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="GAUNTLET" android:textColor="#0F172A" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_active" android:visibility="gone" />
                <TextView android:id="@+id/btnDockBodyWings" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="CYBER WINGS" android:textColor="#A78BFA" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockBodyCape" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="HERO CAPE" android:textColor="#FB7185" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockBodyMecha" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="MECHA ARMOR" android:textColor="#38BDF8" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockBodyStardust" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="STARDUST" android:textColor="#FDE047" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockBodyChroma" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="CHROMA BG" android:textColor="#34D399" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockBodySkel" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="33-PT SKEL" android:textColor="#CBD5E1" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Panel 2C: Dedicated WORLD AR Quick Strip -->
        <HorizontalScrollView
            android:id="@+id/scrollArModeWorldStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:id="@+id/btnDockWorldOff" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="OFF" android:textColor="#94A3B8" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockWorldCube" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="HOLO CUBE" android:textColor="#22D3EE" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockWorldPortal" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="CYBER PORTAL" android:textColor="#C084FC" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockWorldPlanet" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="COSMIC DESK" android:textColor="#38BDF8" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockWorldRuler" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="AR RULER" android:textColor="#34D399" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockWorldGlb" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="GLB STAGE" android:textColor="#FACC15" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockWorldDrop" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="+ DROP" android:textColor="#FACC15" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
                <TextView android:id="@+id/btnDockWorldClear" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="CLR" android:textColor="#FB7185" android:textSize="10sp" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Panel 2D: MIX Multi-Layer Combo Studio -->
        <LinearLayout
            android:id="@+id/layoutArModeMixPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView android:id="@+id/btnDockMixFace" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="FACE" android:textColor="#CBD5E1" android:textSize="9sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/btnDockMixHand" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="HAND" android:textColor="#CBD5E1" android:textSize="9sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/btnDockMixBody" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="BODY" android:textColor="#CBD5E1" android:textSize="9sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/btnDockMixWorld" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="WORLD" android:textColor="#CBD5E1" android:textSize="9sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_inactive" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/btnDockMixRoll" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1.3" android:gravity="center" android:text="WILD COMBO" android:textColor="#0F172A" android:textSize="8.5sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/bg_cinema_button_active" />
        </LinearLayout>

        <!-- Panel 3: AR Text Studio & Comic SFX Controls -->
        <LinearLayout
            android:id="@+id/layoutArModeComicTextPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnArTextStudio"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Aa AR TEXT STUDIO"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />

                <TextView
                    android:id="@+id/btnArComicOnomatopoeia"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="POW! COMIC SFX"
                    android:textColor="#FACC15"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_cinema_button_inactive" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEECH BUBBLE"
                    android:textColor="#CBD5E1"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchArDockBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:thumbTint="#FACC15"
                    app:trackTint="#475569" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO-ADAPT"
                    android:textColor="#CBD5E1"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchArDockAutoAdapt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:checked="true"
                    app:thumbTint="#38BDF8"
                    app:trackTint="#475569" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>